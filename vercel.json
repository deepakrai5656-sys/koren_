{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.12"
      }
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
  {
    "src": "/api/(.*)",
    "dest": "main.py"
  },
  {
    "src": "/(.*\\.(css|js|png|webp|jpg|jpeg|svg|ico))",
    "dest": "/static/$1"
  },
  {
    "src": "/static/(.*)",
    "dest": "/static/$1"
  },
  {
    "src": "/",
    "dest": "/static/index.html"
  }
]
